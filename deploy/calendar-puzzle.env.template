# Runtime environment for the Calendar Puzzle service on a Proxmox LXC.
#
# TEMPLATE ONLY. It holds no real values and is safe to commit.
#
# Install on the container as /etc/calendar-puzzle/env, then fill in every value
# marked CHANGE_ME. Copy the secrets from the working Docker setup; do not generate
# new ones. A new HALL_OF_FAME_PEPPER reshuffles every public userKey and avatar.
#
#   sudo install -o root -g calendar-puzzle -m 0640 \
#       calendar-puzzle.env.template /etc/calendar-puzzle/env
#   sudo -e /etc/calendar-puzzle/env
#
# systemd parses this file itself. It is NOT a shell script: no `export`, no command
# substitution, and no quotes unless the quotes are part of the value.

# --- Secrets. Copy from the Docker .env on the build machine. ---------------------
# The password is the same one the Docker Postgres uses.
DATABASE_URL=postgresql://puzzle:CHANGE_ME@localhost:5432/puzzle
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GITHUB_TOKEN=CHANGE_ME
HALL_OF_FAME_PEPPER=CHANGE_ME

# --- Configuration. Not secret. ---------------------------------------------------
GITHUB_OWNER=yoavain
GITHUB_REPO=calendar-puzzle
NODE_ENV=production
TZ=Asia/Jerusalem

# Prod and dev have separate addresses, so both listen on 3001. There is no
# published-port indirection on an LXC.
PORT=3001

# Must not be 127.0.0.1. Docker's port mapping hides a loopback bind; an LXC has no
# mapping, so a loopback bind is unreachable from the tunnel container while looking
# healthy from inside this one. (3001 is also the code default, but be explicit.)
HOST=0.0.0.0

# Matches TOKENS_BASE_FOLDER in the Dockerfile. The unit grants write access to this
# path only.
TOKENS_BASE_FOLDER=/opt/calendar-puzzle/ext

# Proxmox mounts lxcfs, so Node reads the container's memory cap rather than the
# host's. Setting the heap explicitly decouples the app from the cap.
NODE_OPTIONS=--max-old-space-size=256

# TRUST_PROXY is deliberately unset. The default "loopback, uniquelocal" already
# covers the cloudflared container on the private network. Set it only to narrow the
# trust to the address of your own tunnel container.
# TRUST_PROXY=10.0.0.2/32
