GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
POSTGRES_PASSWORD=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=

# --- Backup and restore -------------------------------------------------------
# Directory the backup scripts write dumps into, on the machine that runs them.
CALENDAR_PUZZLE_DB_BACKUP_PATH=

# --- Proxmox deploy target ----------------------------------------------------
# Only needed for the `:proxmox` scripts. The `:docker` scripts ignore these.
# Addresses of the LXC that runs each environment. There is no default, because
# these describe your network rather than this project.
CALENDAR_PUZZLE_DEV_HOST=
CALENDAR_PUZZLE_PRODUCTION_HOST=

# Optional. Defaults are shown; set these only to override.
# CALENDAR_PUZZLE_DEPLOY_USER=deploy
# CALENDAR_PUZZLE_SSH_KEY=~/.ssh/id_ed25519_calpuzzle
