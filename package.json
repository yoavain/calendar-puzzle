        "drizzle-kit": "0.31.10",
        "embla-carousel-react": "8.6.0",
        "esbuild": "0.28.2",
        "eslint": "9.39.5",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-barrel-files": "3.0.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jasmine": "4.2.2",
        "eslint-plugin-jest": "29.16.1",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-security": "4.0.1",
        "eslint-plugin-unicorn": "65.0.1",
        "globals": "17.11.0",
        "jest": "30.4.2",
        "jest-environment-jsdom": "30.4.1",
        "playwright": "1.62.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router-dom": "7.18.2",
        "rimraf": "6.1.3",
        "rollup-plugin-visualizer": "7.1.1",
        "storybook": "10.5.8",
        "tsx": "4.23.12",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.67.0",
        "vite": "8.2.1"
    },
    "scripts": {
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:docs": "tsx scripts/generate-docs.ts",
        "backup:dev": "node --env-file=.env scripts/db-backup.js --env dev",
        "backup:production": "node --env-file=.env scripts/db-backup.js --env production",
        "restore:dev": "node --env-file=.env scripts/db-restore.js --env dev",
        "restore:production": "node --env-file=.env scripts/db-restore.js --env production",
        "dev": "vite",
        "dev:all": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
        "build": "npm run build:client && npm run build:server",
        "build:client": "rimraf build && vite build && copyfiles -f static/* build",
        "build:server": "rimraf dist && esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external && esbuild src/server/workers/puzzleSolverWorker.ts --bundle --platform=node --format=esm --outfile=dist/server/workers/puzzleSolverWorker.js --packages=external && npm run build:script",
        "build:script": "esbuild scripts/manage-admin.ts --bundle --platform=node --format=esm --outfile=dist/scripts/manage-admin.js --packages=external",
        "preview": "vite preview",
        "start": "npm run build && node dist/server/index.js",
        "test": "npm run type-check && npm run eslint && npm run jest && playwright test --reporter=list",
        "type-check": "tsc --noEmit",
        "jest": "jest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed --workers=1",
        "test:e2e:ui": "playwright test --ui",
        "eslint": "eslint src/ test/ scripts/ --quiet",
        "eslint:fix": "npm run eslint -- --fix",
        "build:image": "npm run test && npm run build && docker build --tag calendar-puzzle --progress=plain --file Dockerfile .",
        "stop:docker:dev": "docker compose -p calendar-puzzle-dev down --remove-orphans",
        "deploy:dev": "npm run build:image && npm run stop:docker:dev && cross-env PORT=23229 docker compose -p calendar-puzzle-dev up -d",
        "deploy:dev:quick": "npm run build:client --ignore-scripts && npm run build:server --ignore-scripts && npm run build:image --ignore-scripts && npm run stop:docker:dev --ignore-scripts && npm run deploy:dev --ignore-scripts",
        "deploy:production": "npm run build:image && docker compose -p calendar-puzzle-production down --remove-orphans && cross-env PORT=23222 docker compose -p calendar-puzzle-production up -d",
        "admin:add": "node dist/scripts/manage-admin.js add",
        "admin:remove": "node dist/scripts/manage-admin.js remove",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "graphify:build": "graphify extract . --code-only",
        "graphify:update": "graphify update . && graphify label . --backend claude-cli",
        "graphify:report": "graphify cluster-only . --no-label"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": ""
}
