{
    "name": "calendar-puzzle",
    "version": "0.9.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@fastify/csrf-protection": "7.1.0",
        "@fastify/passport": "3.0.2",
        "@fastify/rate-limit": "10.3.0",
        "@fastify/secure-session": "8.3.0",
        "@fastify/static": "9.0.0",
        "@octokit/rest": "22.0.1",
        "dlx": "0.2.1",
        "drizzle-orm": "0.45.1",
        "fastify": "5.7.1",
        "passport-google-oauth20": "2.0.0",
        "pg": "8.17.2"
    },
    "devDependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.1",
        "@eslint/compat": "2.0.1",
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "9.39.2",
        "@mui/icons-material": "7.3.7",
        "@mui/material": "7.3.7",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/jest": "30.0.0",
        "@types/node": "24.10.9",
        "@types/passport-google-oauth20": "2.0.17",
        "@types/pg": "8.16.0",
        "@types/react": "19.2.9",
        "@types/react-dom": "19.2.3",
        "@typescript-eslint/eslint-plugin": "8.53.1",
        "@typescript-eslint/parser": "8.53.1",
        "@vitejs/plugin-react": "5.1.2",
        "concurrently": "9.2.1",
        "cross-env": "10.1.0",
        "drizzle-kit": "0.31.8",
        "esbuild": "0.27.2",
        "eslint": "9.39.2",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jasmine": "4.2.2",
        "eslint-plugin-jest": "29.12.1",
        "eslint-plugin-n": "17.23.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-security": "3.0.1",
        "eslint-plugin-unicorn": "62.0.0",
        "globals": "17.1.0",
        "jest": "30.2.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "rimraf": "6.1.2",
        "ts-jest": "29.4.6",
        "ts-node": "10.9.2",
        "tsx": "4.21.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.53.1",
        "vite": "7.3.1"
    },
    "scripts": {
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "dev": "vite",
        "dev:all": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
        "build": "npm run build:client && npm run build:server",
        "prebuild:client": "rimraf build",
        "build:client": "vite build",
        "prebuild:server": "rimraf dist",
        "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external && esbuild src/server/workers/puzzleSolverWorker.ts --bundle --platform=node --format=esm --outfile=dist/server/workers/puzzleSolverWorker.js --packages=external && npm run build:script",
        "build:script": "esbuild scripts/manage-admin.ts --bundle --platform=node --format=esm --outfile=dist/scripts/manage-admin.js --packages=external",
        "preview": "vite preview",
        "prestart": "npm run build",
        "start": "node dist/server/index.js",
        "test": "npm run type-check && npm run eslint && npm run jest",
        "type-check": "tsc --noEmit",
        "jest": "jest",
        "eslint": "eslint src/ test/ scripts/",
        "eslint:fix": "npm run eslint -- --fix",
        "prebuild:image": "npm run build",
        "build:image": "docker build --tag calendar-puzzle --progress=plain --file Dockerfile .",
        "predeploy:dev": "npm run build:image && docker compose -p calendar-puzzle-dev down --remove-orphans",
        "deploy:dev": "cross-env PORT=23229 docker compose -p calendar-puzzle-dev up -d",
        "predeploy:production": "npm run build:image && docker compose -p calendar-puzzle-production down --remove-orphans",
        "deploy:production": "cross-env PORT=23222 docker compose -p calendar-puzzle-production up -d",
        "admin:add": "node dist/scripts/manage-admin.js add",
        "admin:remove": "node dist/scripts/manage-admin.js remove"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": ""
}
