{
    "name": "calendar-puzzle",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@fastify/static": "9.0.0",
        "dlx": "0.2.1",
        "fastify": "5.7.0",
        "react": "19.2.3",
        "react-dom": "19.2.3"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.1",
        "@testing-library/user-event": "14.6.1",
        "@types/jest": "30.0.0",
        "@types/node": "25.0.9",
        "@types/react": "19.2.8",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.1.2",
        "concurrently": "9.2.1",
        "esbuild": "0.27.2",
        "jest": "30.2.0",
        "ts-jest": "29.4.6",
        "ts-node": "10.9.2",
        "tsx": "4.21.0",
        "typescript": "5.9.3",
        "vite": "7.3.1"
    },
    "scripts": {
        "dev": "vite",
        "dev:all": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
        "build": "npm run build:client && npm run build:server",
        "build:client": "vite build",
        "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external && esbuild src/server/workers/puzzleSolverWorker.ts --bundle --platform=node --format=esm --outfile=dist/server/workers/puzzleSolverWorker.js --packages=external",
        "preview": "vite preview",
        "prestart": "npm run build",
        "start": "node dist/server/index.js",
        "test": "jest"
    },
